    "seocheon-cc-hub": {
      "r": "ko",
      "g": [
        "ko",
        "서천컨트리클럽",
        "허브"
      ],
      "os": 30,
      "desc": "를 적듯이 말이죠. 원한다면 문어체 대본 파트가 아니라 구어체 잡담에 실어서 전달해도 됩니다. 서천CC 서식은 잘 다듬어진 보고서가 아니라 약간 두서없이 이어지는 대화니까요. 등록 귀중품 정보 항목 이 파트는 안매화 가 고정으로 참여하고, 서천 자매 중 한 명과 대화를 주고받으며 진행합니다. 서천CC에는 각종 개인 소유물을 직접 반입할 수도 있고 리조트 측에 맡겨둘 수도 있지만, 어느 쪽이든 반입 품목으로써 등록을 해야 합니다. 이 항목에선 서식 주인공이 등록해…",
      "img": "http://scpko.wdfiles.com/local--files/theme%3Aflowergarden/scc.png",
      "lu": 1763351847,
      "bf": 1763351847
    },
    "goc-far-east-orientation": {
      "r": "ko",
      "g": [
        "jp",
        "공저",
        "부호부대",
